<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.katelauncher.bjudzetnykukrainianlinuxcommunity">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Запуск Linux-програм через Termux (потрібен також allow-external-apps=true у termux.properties) -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <queries>
        <package android:name="com.termux" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
    </queries>

    <application
        android:name=".core.App"
        android:icon="@drawable/ic_launcher"
        android:label="KateLauncher0.8.0ExLE"
        android:extractNativeLibs="false"
        android:theme="@style/SettingsTheme"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".core.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/HomeTheme"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|density|uiMode|locale|layoutDirection|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity android:name=".settings.SettingsActivity" android:label="KateLauncher" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".wallpaper.WallpaperCropActivity" android:exported="false" />
        <service android:name=".dock.DockOverlayService" android:exported="false" />
        <!-- Приймає Binder композитора з Termux (перевіряється токен). Не служба. -->
        <receiver android:name=".linux.wl.HostReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.katelauncher.bjudzetnykukrainianlinuxcommunity.WL_HOST" />
            </intent-filter>
        </receiver>
        <receiver android:name=".dock.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
